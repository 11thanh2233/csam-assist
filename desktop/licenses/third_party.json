    },
    {
      "name": "DINOv2 small (Meta)",
      "use": "Nhận lại người khi theo dõi",
      "license": "Apache-2.0",
      "url": "https://huggingface.co/facebook/dinov2-small",
      "bundled": false,
      "use_en": "Re-identifying people when tracking"
    },
    {
      "name": "Depth Anything V2 Small",
      "use": "Độ sâu: ai đứng trước ai khi theo dõi",
