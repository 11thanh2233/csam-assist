# Chép file này thành ".env" rồi sửa nếu cần. Mọi dòng đều tuỳ chọn.

# auto = thử gói sam3 chính thức trước, rồi tới transformers
# sam3 | transformers | mock (mock: không cần model, chỉ để thử giao diện)
SAM3_ENGINE=auto

# auto | cuda | cpu | mps
SAM3_DEVICE=auto

# Chỉ nghe trên máy này. Đổi thành 0.0.0.0 nếu trình duyệt nằm ở máy khác (khi đó BẮT BUỘC đặt API key).
SAM3_HOST=127.0.0.1
SAM3_PORT=8765

# Đặt một chuỗi bất kỳ; nhập đúng chuỗi này vào tab "Cài đặt" của panel.
SAM3_API_KEY=
# Tên Host được nhận (cách nhau bằng dấu phẩy). Bỏ trống: chỉ localhost khi SAM3_HOST=127.0.0.1, mọi tên khi mở ra mạng.
# Dùng backend từ máy khác qua tên máy/IP: thêm tên đó, ví dụ SAM3_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.20
SAM3_ALLOWED_HOSTS=

# Model trên Hugging Face (engine transformers) và checkpoint cục bộ (engine sam3, tuỳ chọn)
SAM3_HF_MODEL=facebook/sam3
SAM3_CHECKPOINT=

# Ngưỡng tin cậy thấp nhất lấy từ model; ngưỡng từng label chỉnh trên panel hoặc trong profile
SAM3_MIN_CONF=0.25

# Model phụ cho skeleton (chỉ nạp khi job có label skeleton)
# Tư thế người: tải tự động từ Hugging Face ở lần dùng đầu (không cần xin quyền)
SAM3_POSE_MODEL=usyd-community/vitpose-base-simple
# Khuôn mặt (MediaPipe): để trống thì tự tải về models/face_landmarker.task ở lần dùng đầu
SAM3_FACE_MODEL=

# ---- Soạn guideline nháp (tab Guideline) ----
# Không cấu hình gì: tool vẫn soạn được từ số liệu, guideline mẫu và bài học đã có.
# Có LLM: tool viết thêm định nghĩa class mới, quy tắc cho cặp dễ nhầm, và chạy "annotator ảo".
# auto = dùng Claude API nếu có ANTHROPIC_API_KEY, nếu không thì dùng máy chủ tương thích OpenAI bên dưới.
# auto | anthropic | openai | none
GUIDELINE_LLM=auto

# Cách 1 - Claude API (ảnh và số liệu gửi tới Anthropic; trả phí theo lượng dùng)
ANTHROPIC_API_KEY=
# Cách 2 - model chạy trên máy qua Ollama / LM Studio (máy chủ tương thích OpenAI), ví dụ:
#   GUIDELINE_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   GUIDELINE_LLM_MODEL=<tên model có thị giác bạn đã tải>
GUIDELINE_OPENAI_BASE_URL=
GUIDELINE_OPENAI_API_KEY=
# Tên model. Để trống khi dùng Claude API sẽ lấy claude-sonnet-5-5.
GUIDELINE_LLM_MODEL=

# Thư mục thư viện guideline (guideline mẫu, bài học, các lượt soạn). Mặc định: guideline_library/
SAM3_LIBRARY_DIR=
